# Second Brain Agent - Environment Variables
# Copy this file to .env and fill in the values

# OpenRouter API Configuration (required)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-4
# Model for /generate (wins over OPENROUTER_MODEL); set in .env locally and in the Modal secret agui-generate-secrets
GENERATE_MODEL=openai/gpt-5.6-sol
# Optional: low|medium|high (unset = provider default)
OPENROUTER_REASONING_EFFORT=medium

# Server Configuration (optional)
BACKEND_PORT=8000

# API Key — required in production, protects POST / and POST /api/generate
# Consumers send: Authorization: Bearer <key>
# Leave empty to skip auth (local dev only)
API_KEY=XXXX

# CORS Configuration (optional - includes common local dev ports)
ALLOWED_ORIGINS=http://localhost:3010,http://localhost:3011,http://localhost:3012,http://localhost:3000

# Jev (TypeSafe System One decision model) via OpenRouter — classifies the document type in /generate.
# Uses OPENROUTER_API_KEY above. Unset = typesafe/jev-1.13 (pinned version). Set it in the Modal secret agui-generate-secrets too.
JEV_MODEL=typesafe/jev-1.13

# --- Local testing without OpenRouter (never set these on Modal/Railway) ---
# LLM backend for call_llm: openrouter (default, production) | codex (runs the local `codex` CLI on your
# ChatGPT/Codex subscription; refused at startup when a Modal/Railway/Cloud Run marker is set).
LLM_BACKEND=openrouter
# Codex model; unset = GENERATE_MODEL with the vendor/ prefix stripped (openai/gpt-5.6-sol -> gpt-5.6-sol).
# Reasoning effort comes from OPENROUTER_REASONING_EFFORT.
CODEX_MODEL=
# Max parallel Codex CLI processes (Codex is slow and rate-limited).
CODEX_MAX_CONCURRENCY=2
# 1 = skip the Jev OpenRouter call; document type comes from the heuristic classifier.
JEV_DISABLED=0
